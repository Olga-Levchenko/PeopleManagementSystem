# App
PORT=3004
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=work_management_service
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_management_service

# Keycloak -- this service independently re-verifies the same bearer token the BFF already
# validated at the edge and forwards unchanged (never a caller-supplied actorId). Derives its own
# issuer/JWKS URI from these two values (same formula as authentication-service's
# AppConfig.Issuer/JwksUri, people-service's own JwtStrategy, and the BFF's), never a live call to
# authentication-service. KEYCLOAK_REALM must exactly match the realm authentication-service
# actually has provisioned -- a typo here fails as a generic JWKS-fetch/401 error, not a clear
# config error.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=people-management

# access-control-service -- called by ManagementNotesService to resolve the caller's access role
# (reporting/PP/project-line + projectRoles) toward an S7 note's subject. Native fetch only, no
# client library. A network failure/non-2xx fails closed to "no access", but a missing base URL
# must still fail fast at startup (no Joi default).
ACCESS_CONTROL_SERVICE_BASE_URL=http://localhost:3007

# people-service -- called to resolve JWT iss+sub to platform Person.id (O4-142).
PEOPLE_SERVICE_BASE_URL=http://localhost:3002

# Service-to-service token exchange credentials (deployment-provided; never commit the private key).
SERVICE_AUTH_PRIVATE_KEY_PATH=
SERVICE_AUTH_KEY_ID=work-management-service-local
SERVICE_AUTH_SIGNING_ALG=RS256
