generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS runs on CommonJS — without this the generated client is ESM and breaks the build
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Domain models go here.

// S7 Management notes (Story 1.7 scaffold only — no service/controller yet; flag-gating
// behavior, defaults enforcement, and PM-vs-DM read/write logic are Story 1.7's own spec,
// pending the projectRoles decision in ADR-003's 2026-09-02 addendum.
model ManagementNote {
  id               String   @id @default(uuid())
  subjectPersonId  String
  authorPersonId   String
  content          String
  visibleForEmployee Boolean @default(false)
  visibleForPm       Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("management_notes")
}

enum ActionItemStatus {
  open
  completed
  cancelled
}

enum ActionItemSource {
  manual
  campaign
}

model ActionItem {
  id               String           @id @default(uuid())
  title            String
  description      String?
  assigneePersonId String
  authorPersonId   String
  dueDate          DateTime
  linkUrl          String?
  campaignId       String?
  status           ActionItemStatus @default(open)
  source           ActionItemSource @default(manual)
  completionDate   DateTime?
  cancelReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([campaignId, assigneePersonId])
  @@map("action_items")
}

model ProcessedCampaignActivationEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@map("processed_campaign_activation_events")
}
