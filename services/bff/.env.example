# App
PORT=3001
CORS_ORIGIN=http://localhost:4200
PEOPLE_SERVICE_URL=http://localhost:3002
ACCESS_CONTROL_SERVICE_BASE_URL=http://localhost:3007

# Keycloak -- the BFF derives its own issuer/JWKS URI from these two values (same formula as
# authentication-service's AppConfig.Issuer/JwksUri), never a live call to authentication-service.
# KEYCLOAK_REALM must exactly match the realm authentication-service actually has provisioned -- a
# typo here fails as a generic JWKS-fetch/401 error, not a clear config error.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=people-management
