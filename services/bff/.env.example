# App
PORT=3001
CORS_ORIGIN=http://localhost:4200
PEOPLE_SERVICE_URL=http://localhost:3002
ACCESS_CONTROL_SERVICE_BASE_URL=http://localhost:3007
WORK_MANAGEMENT_SERVICE_URL=http://localhost:3004

# Keycloak -- the BFF derives its own issuer/JWKS URI from these two values (same formula as
# authentication-service's AppConfig.Issuer/JwksUri), never a live call to authentication-service.
# KEYCLOAK_REALM must exactly match the realm authentication-service actually has provisioned -- a
# typo here fails as a generic JWKS-fetch/401 error, not a clear config error.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=people-management
# private_key_jwt material is deployment-injected; never commit the private key.
KEYCLOAK_CLIENT_PRIVATE_KEY_PATH=
KEYCLOAK_CLIENT_KEY_ID=
KEYCLOAK_CLIENT_AUTH_SIGNING_ALG=RS256
# Session cookie signing secret -- must be at least 32 characters; use a random value in production.
SESSION_SECRET=local-dev-session-secret-32chars-min
# Full callback URL Keycloak redirects to after authorization -- must match a redirectUri in realm-export.json.
OIDC_CALLBACK_URL=http://localhost:3001/api/v1/auth/callback
# Optional: PostgreSQL connection string for the persistent session store (connect-pg-simple).
# Leave blank for MemoryStore (local dev without Postgres). Set to a real URL in production/CI.
DATABASE_URL=

# private_key_jwt material is deployment-injected; never commit the private key.
SERVICE_AUTH_PRIVATE_KEY_PATH=
SERVICE_AUTH_KEY_ID=
