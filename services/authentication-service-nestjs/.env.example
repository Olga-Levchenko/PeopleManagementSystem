# App
PORT=3008
CORS_ORIGIN=http://localhost:4200

# Keycloak — this service's own realm/client provisioning (keycloak/realm-export.json) plus
# the discovery info GET /api/v1/auth/config resolves for downstream JWT-validating services
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=people-management
