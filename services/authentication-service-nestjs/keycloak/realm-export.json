{
  "id": "people-management",
  "realm": "people-management",
  "displayName": "People Management Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "bff-confidential",
      "name": "BFF confidential client",
      "description": "Confidential client used by the BFF authorization-code + PKCE flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:4200"],
      "fullScopeAllowed": true,
      "attributes": {
        "use.jwks.url": "true",
        "token.endpoint.auth.signing.alg": "RS256",
        "jwks.url": "http://host.docker.internal:3001/api/v1/auth/jwks"
      }
    },
    {
      "clientId": "bff-direct-grant-test",
      "name": "BFF direct-grant integration test client",
      "description": "Test-only client for the authentication integration suite; not used by the BFF runtime.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "use.jwks.url": "true",
        "token.endpoint.auth.signing.alg": "RS256",
        "jwks.url": "http://host.docker.internal:3001/api/v1/auth/jwks"
      }
    }
  ],
  "users": [
    {
      "username": "story1-11.test-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Story1-11",
      "lastName": "TestUser",
      "email": "story1-11.test-user@peoplemanagement.local",
      "credentials": [
        {
          "type": "password",
          "value": "Story1-11-TestPassword!",
          "temporary": false
        }
      ]
    }
  ]
}
