<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately near-zero external package references: this project is the pure-logic core of the
    hexagonal split (AD-1 / architecture spine "hexagonal service internals"). AccessRoleResolver
    must be testable and reasoned about without EF Core, ASP.NET Core, or any other dependency in
    scope. Infrastructure implements IRelationshipRepository against EF Core; Api composes the two
    at startup. The one exception is Microsoft.Extensions.Logging.Abstractions below, a pure,
    provider-agnostic logging interface (ILogger of T) with no ties to any concrete logging backend
    or hosting concern, added so AccessRoleResolver can log a warning when its cycle-guarded walks
    are truncated without finding a match (see MaxHops usage), without pulling in a real logging
    implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
  </ItemGroup>

</Project>
