# App
PORT=3007
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose) -- INFORMATIONAL ONLY: these four vars are not read by this app
# anywhere (AppConfig.cs/Program.cs never reference them). They exist purely as a human-readable
# breakdown of the components baked into ConnectionStrings__Postgres below. Editing them here does
# NOT change what this app connects with -- edit ConnectionStrings__Postgres itself instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=access_control_service
POSTGRES_PORT=5432

# ASP.NET Core reads ConnectionStrings:Postgres from the double-underscore env var below
# (standard ASP.NET Core Configuration convention for nested keys). This is the actual, only
# value this app uses to connect to Postgres.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=access_control_service;Username=postgres;Password=postgres

# RabbitMQ (docker-compose) -- required, fail-fast AppConfig values ProjectAssignmentEventConsumer
# needs to reach a real broker. Same guest/guest defaults infra/docker-compose.yml's own RabbitMQ
# container falls back to when RABBITMQ_USER/RABBITMQ_PASSWORD are unset there.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# People Service identity resolver endpoint. Calls use a short-lived exchanged token.
PEOPLE_SERVICE_BASE_URL=http://localhost:3002

# Required OIDC issuer and audience for end-user JWT validation. Startup fails closed when either
# value is missing, malformed, non-canonical, or inconsistent with the service policy.
# Local docker-compose Keycloak is HTTP-only; production startup still requires HTTPS.
OIDC_ALLOWED_ISSUERS=http://localhost:8080/realms/people-management
OIDC_AUDIENCE=bff-confidential

# private_key_jwt material is deployment-injected; never commit the private key.
SERVICE_AUTH_PRIVATE_KEY_PATH=
SERVICE_AUTH_KEY_ID=

# Public key used to validate deployment-bootstrap client assertions.
DEPLOYMENT_BOOTSTRAP_PUBLIC_KEY_PATH=
DEPLOYMENT_BOOTSTRAP_KEY_ID=deployment-bootstrap-local
