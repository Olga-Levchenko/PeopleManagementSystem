# App
PORT=3002
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=people_service
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/people_service
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=people.relationships
OUTBOX_PUBLISHER_RETRY_LIMIT=5
OUTBOX_STALE_LOCK_MINUTES=10
OUTBOX_PUBLISHER_INTERVAL_MS=1000

# Keycloak -- this service independently re-verifies the same bearer token the BFF already
# validated at the edge and forwards unchanged (never a caller-supplied actorId). Derives its own
# issuer/JWKS URI from these two values (same formula as authentication-service's
# AppConfig.Issuer/JwksUri and the BFF's own JwtStrategy), never a live call to authentication-service.
# KEYCLOAK_REALM must exactly match the realm authentication-service actually has provisioned -- a
# typo here fails as a generic JWKS-fetch/401 error, not a clear config error.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=people-management
