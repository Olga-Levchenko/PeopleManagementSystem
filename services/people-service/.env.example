# App
PORT=3002
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=people_service
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/people_service
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=people.relationships
OUTBOX_PUBLISHER_RETRY_LIMIT=5
OUTBOX_STALE_LOCK_MINUTES=10
OUTBOX_PUBLISHER_INTERVAL_MS=1000
