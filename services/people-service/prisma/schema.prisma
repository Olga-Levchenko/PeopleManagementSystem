generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS runs on CommonJS — without this the generated client is ESM and breaks the build
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RelationshipType {
  REPORTS_TO
  PP_ASSIGNMENT
  DEPARTMENT_MEMBERSHIP
  DEPARTMENT_MANAGER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum OutboxAggregateType {
  PERSON
  DEPARTMENT
}

enum FreshnessStatus {
  UNCERTAIN
  CONFIRMED
}

model Person {
  id                   String       @id @default(uuid()) @db.Uuid
  managerId            String?      @db.Uuid
  peoplePartnerId      String?      @db.Uuid
  departmentId         String?      @db.Uuid
  relationshipVersion  Int          @default(0)
  manager              Person?      @relation("person_manager", fields: [managerId], references: [id], onDelete: Restrict)
  reports              Person[]     @relation("person_manager")
  peoplePartner        Person?      @relation("person_pp", fields: [peoplePartnerId], references: [id], onDelete: Restrict)
  partneredPeople      Person[]     @relation("person_pp")
  department           Department?  @relation("person_department", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentManagerOf  Department[] @relation("department_manager")

  // S1 -- Identity card (Story 1.6). fullName is non-nullable: an empty profile identity would
  // make every s1.fullName assertion meaningless, and this table carries no seeded rows yet to
  // backfill.
  fullName             String
  photoUrl             String?
  position             String?
  countryCity          String?
  workEmail            String?
  workPhone            String?
  birthdayMonth        Int?
  birthdayDay          Int?
  startDate            DateTime?

  // S2 -- Personal contacts (Story 1.6).
  personalPhone        String?
  personalEmail        String?
  residentialAddress   String?

  // S10/S11 -- Leaves and project assignments (Story 1.8).
  leaves                    Leave[]
  personProjectAssignments  PersonProjectAssignment[]

  // S16 -- Custom field values (Story 1.10).
  customFieldValues         CustomFieldValue[]

  @@map("people")
}

model Department {
  id                  String      @id @default(uuid()) @db.Uuid
  managerId           String?     @db.Uuid
  relationshipVersion Int         @default(0)
  members             Person[]    @relation("person_department")
  manager             Person?     @relation("department_manager", fields: [managerId], references: [id], onDelete: Restrict)
  // Backing data for S1's department/unit field on the profile response (Story 1.6).
  name                String?

  @@map("departments")
}

model RelationshipJournalEntry {
  id             String           @id @default(uuid()) @db.Uuid
  relationship   RelationshipType
  actorId        String           @db.Uuid
  subjectId      String           @db.Uuid
  beforeId       String?          @db.Uuid
  afterId        String?          @db.Uuid
  occurredAtUtc  DateTime         @default(now())

  @@index([subjectId, occurredAtUtc])
  @@map("relationship_journal_entries")
}

model OutboxEvent {
  eventId             String             @id @default(uuid()) @db.Uuid
  aggregateType       OutboxAggregateType
  aggregateId         String             @db.Uuid
  aggregateVersion    Int
  payload             Json
  status              OutboxStatus       @default(PENDING)
  retryCount          Int                @default(0)
  nextAttemptAt       DateTime?
  lastError           String?
  createdAtUtc        DateTime           @default(now())
  publishedAtUtc      DateTime?
  lockedAtUtc         DateTime?
  lockedBy            String?            @db.Uuid

  @@index([status, nextAttemptAt])
  @@index([aggregateId, aggregateVersion])
  @@unique([aggregateType, aggregateId, aggregateVersion])
  @@map("outbox_events")
}

// S10 -- Leaves and absences (Story 1.8).
model Leave {
  id         String   @id @default(uuid()) @db.Uuid
  personId   String   @db.Uuid
  startDate  DateTime
  endDate    DateTime
  leaveType  String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

// S11 -- Project assignments as seen from the profile (Story 1.8).
// This is people-service's own read model -- separate from access-control-service's
// ProjectAssignment projection which is used only for access-role resolution.
model PersonProjectAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  personId    String    @db.Uuid
  projectName String
  role        String?
  startDate   DateTime?
  endDate     DateTime?
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("person_project_assignments")
}

model RelationshipProjectionFreshness {
  subjectId          String          @id @db.Uuid
  status             FreshnessStatus @default(CONFIRMED)
  reason             String?
  detectedAtUtc      DateTime?
  lastConfirmedAtUtc DateTime?

  @@map("relationship_projection_freshness")
}

// S16 -- Custom fields (Story 1.10).
enum CustomFieldVisibility {
  MANAGEMENT
  EMPLOYEE
  COLLEAGUE
}

model CustomFieldDefinition {
  id         String                 @id @default(uuid()) @db.Uuid
  name       String
  visibility CustomFieldVisibility  @default(MANAGEMENT)
  isActive   Boolean                @default(true)
  values     CustomFieldValue[]

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String                @id @default(uuid()) @db.Uuid
  definitionId String                @db.Uuid
  personId     String                @db.Uuid
  value        String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  person       Person                @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([definitionId, personId])
  @@map("custom_field_values")
}
