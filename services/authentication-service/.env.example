# App
PORT=3008
CORS_ORIGIN=http://localhost:4200

# Keycloak -- this service owns realm/client provisioning (keycloak/realm-export.json, applied via
# Keycloak's own --import-realm startup flag) and resolves GET /api/v1/auth/config from these two
# values plus the fixed OIDC path shapes Keycloak itself uses. No ConnectionStrings:Postgres here:
# this service is stateless, Keycloak is the identity store.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=people-management
